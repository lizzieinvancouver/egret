% <><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
\section{Methods}
% <><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
\begin{enumerate}
\item First, we selected all the datasetIDstudy that had more than one provenance per species across the whole egret database (`provenanceVisualization.R'; nrow $n = $ \Sexpr{nrow(dmore1prov)}. Second, we ran Victor's decision rules (`decisionRules.R') which yields \Sexpr{nrow(newd)} rows of data. Third, we cleaned the dataset before fitting the model with forcing (`modelingCues.R'), yielding \Sexpr{nrow(modeld)} rows of data. 

\item We fit the provenance model with and without forcing first, compared model estimates and moved on with the model without forcing; with chilling and time as the main predictors. See the section `comparing models' below for more details. %emw11Aug: I would show the equation... I can write it in tex for you if you need help and point me to the Stan file. 

\item We compared the no-forcing model with the restricted (only the data with forcing information) versus the full dataset

\end{enumerate}

\textbf{Model with forcing:}
\begin{align}
p(\mu_i | \theta) &= \begin{cases} 
    1 -  logit^{-1}(\mu_i - k_1) & \text{if } \mu_i = 0 \\
    [logit^{-1}(\mu_i - k_1) - logit^{-1}(\mu_i - k_2)] - \text{Beta\_proportion}(logit^{-1}(\mu_i), k_1) & \text{if } \mu_i \in ]0, 1[ \\
    logit^{-1}(\mu_i - k_2) & \text{if } \mu_i = 1
\end{cases} \\
\mu_i &= \alpha_{[sp]} + \alpha_{[prov]} + \\
& \notag (\beta_{t[sp]} + \beta_{t[prov]}) \cdot \text{time} + \\
& \notag (\beta_{f[sp]} + \beta_{f[prov]}) \cdot \text{forcing} + \\
& \notag (\beta_{cs[sp]} + \beta_{cs[prov]}) \cdot \text{chilling} \\
% \alpha_{[sp]} &\sim \text{normal}(\mu_{\alpha}, \sigma_{\alpha}) \\
% \alpha_{[prov]} &\sim \text{normal}(0, \sigma_{[prov]}) \\ 
%  Need to finish writing these priors
% \beta_{chilling_{[sp]}} &\sim \text{normal}(\mu_{\beta_{chilling}}, \sigma_{\beta_{chilling}})\\
% \beta_{chilling_{[prov]}} &\sim \text{normal}(0, \sigma_{[prov]}) \\
% \beta_{[prov]} &\sim \text{normal}(0, \sigma_{[prov]}) \\
% \beta_{[sp]} &\sim \text{normal}(\mu_{\alpha}, \sigma_{\alpha})\\
% \beta_{[prov]} &\sim \text{normal}(0, \sigma_{[prov]})
\end{align}

\textbf{Selected model (no-forcing):}
\begin{align}
\mu_i &= \alpha_{[sp]} + \alpha_{[prov]} + \\
& \notag (\beta_{t[sp]} + \beta_{t[prov]}) \cdot \text{time} + \\
& \notag (\beta_{cs[sp]} + \beta_{cs[prov]}) \cdot \text{chilling}
\end{align}

% <><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
\section{Results}
% <><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><><>
For the dataset that includes forcing (henceforth referred to as `restricted'), we have \Sexpr{length(unique(modeld$genusspecies))} single species from \Sexpr{length(unique(paste(modeld$datasetID, modeld$study, sep = "")))} datasetID. For the dataset without forcing (henceforth referred to as `full'), we have \Sexpr{length(unique(modeld_noforc$genusspecies))} single species from \Sexpr{length(unique(paste(modeld_noforc$datasetID, modeld$study, sep = "")))} datasetID.



%-------------------------------------------------------------------------------
\subsection*{Comparing models}
%-------------------------------------------------------------------------------
  \begin{enumerate}
  
  \item We fitted the model with forcing on the most restricted dataset, without and with provenance, which did not change the estimates (Figure \ref{fig:provNoProv})
  
  \item Excluding forcing from the model did not influence the other parameters consistently across species or provenances
  
  \item Forcing does not seem to explain the variation between the no-forcing and forcing models: neither the maximum temperature (Figure \ref{fig:maxGermTemp}), the number of unique germination treatments (Figure \ref{fig:uniqueGermTemp}) or the temperature interval seem to explain the observed variation (Figure \ref{fig:germTempInterval}) between the restricted vs full dataset.

  \item The estimates were unchanged when fitting the no-forcing model with the most restricted data ($n =$ \Sexpr{nrow(modeld)}) and the full dataset ($n =$ \Sexpr{nrow(modeld_noforc2)}). 
  

  \end{enumerate}

%-------------------------------------------------------------------------------
\subsection*{Results from selected model, i.e. the no-forcing model}
%-------------------------------------------------------------------------------
\begin{enumerate}

  \item Chilling increased germination for most species with huge variations. Four species probability to germinate decreased in response to chilling (Figure \ref{fig:muChilling}).
  
  \item Time had a similar trend to forcing, with some more species increasing germination in response to time. Most of them didn't shift (Figure \ref{fig:muTime}).
  
  \item Germination varied more across species ($\sigma$ =
  \Sexpr{sig_sum$mu[sig_sum$prm == "sigma_a"]} (UI:
  \Sexpr{sig_sum$p05[sig_sum$prm == "sigma_a"]},
  \Sexpr{sig_sum$p95[sig_sum$prm == "sigma_a"]})) than across provenances ($\sigma$ =
  \Sexpr{sig_sum$mu[sig_sum$prm == "sigma_a_prov"]} (UI:
  \Sexpr{sig_sum$p05[sig_sum$prm == "sigma_a_prov"]},
  \Sexpr{sig_sum$p95[sig_sum$prm == "sigma_a_prov"]}) Figure \ref{fig:muSigma})
  
  \item We show global germination responses across all species as a function of chilling (Figure \ref{fig:respCurveChilling}) and time (Figure \ref{fig:respCurveTime}).
  
\end{enumerate}
  

% Provenance model comparison with model without provenance
\begin{figure}[!ht]
\includegraphics[width=0.7\textwidth]{../../analyses/analyseSeedCues/provenance/figures/11PlotProvNoProv.jpeg}
\caption{Comparing the no-provenance vs provenance models. Both of these models include the forcing parameters. We compare model parameters on a 1:1 line (red dashed line) where the y-axis represents the model that excludes provenance and the x-axis depicts the model that includes the provenance parameters. `a' is the grand intercept for each species, `bcs' is the chilling slope for each species, `bf' is the forcing slope for each species  and `bt' is the time slope for each species.}
\label{fig:provNoProv}
\end{figure}


